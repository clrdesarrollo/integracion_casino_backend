# Copia este archivo como `variables.env` y completa los valores.
# `variables.env` está en .gitignore: nunca lo subas al repositorio.

# ---- PostgreSQL ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=casino_backend
HOST_DB=pgdb
PORT_DB=5432

# ---- Django ----
DJANGO_SECRET_KEY=''
DEBUG=1
ALLOWED_HOSTS='*'
CSRF_TRUSTED_ORIGINS=''
DJANGO_LOG_LEVEL=INFO
TIME_ZONE=America/Santiago

# ---- Reportería: minutos de gracia para atribuir marcaciones fuera de turno ----
# (debe coincidir con el valor usado por la app CasinoAccess; por defecto 15)
REPORT_GRACE_MINUTES=15

# ---- Redis (Channels / tiempo real) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Superusuario inicial (creado por el entrypoint si no existe) ----
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
